{
  "name": "pulserpc",
  "displayName": "PulseRPC Syntax Highlighting",
  "description": "Syntax highlighting for Pulse IDL files",
  "version": "0.1.0",
  "publisher": "JamesCooper",
  "engines": {
    "vscode": "^1.80.0",
    "cursor": ">=0.10.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:pulse"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "pulse",
      "aliases": ["Pulse IDL", "pulse", "pulserpc"],
      "extensions": [".pulse"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "pulse",
      "scopeName": "source.pulse",
      "path": "./syntaxes/pulse.tmGrammar.json"
    }]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "package": "vsce package",
    "test": "node tests/syntax/run-tests.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pulserpc/pulserpc"
  },
  "bugs": {
    "url": "https://github.com/pulserpc/pulserpc/issues"
  },
  "homepage": "https://github.com/pulserpc/pulserpc#readme",
  "author": "PulseRPC",
  "license": "MIT"
}
